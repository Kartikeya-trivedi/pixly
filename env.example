# Game Overlay AI - Environment Configuration
# Copy this file to .env and update the values

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Database Configuration
DATABASE_URL=sqlite:///./game_overlay.db
# For PostgreSQL: postgresql://user:password@localhost:5432/game_overlay_ai

# Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
VECTOR_DB_COLLECTION_NAME=game_guides
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# AI/LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# RAG Configuration
MAX_TIPS_PER_REQUEST=5
OVERLAY_UPDATE_INTERVAL=5

# Security Configuration
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379/0

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=["txt", "md", "json", "pdf"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Development
RELOAD_ON_CHANGE=true
AUTO_MIGRATE=true
